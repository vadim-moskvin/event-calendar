{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=users;Username=postgres;Password=postgres"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "TokenSettings": {
    "Issuer": "EventCalendar.Auth",
    "Audiences": ["EventCalendar.Events", "EventCalendar.Bookings"],
    "ExpirationMinutes": 60
  },
  "ServiceName": "auth-service",
  "ServiceVersion": "1.0.0",
  "Otlp": {
    "Endpoint": "http://localhost:4317"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
